{
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "JobPortal"
  },

  "JwtSettings": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS",
    "Issuer": "JobPortal",
    "Audience": "JobPortalUsers"
  },

  "CloudinarySettings": {
    "CloudName": "your_cloud_name",
    "ApiKey": "your_api_key",
    "ApiSecret": "your_api_secret",
    "CloudinaryUrl": "cloudinary://api_key:api_secret@cloud_name",
    "UploadPreset": "job_portal_images",
    "ImageUploadPreset": "job_portal_images",
    "RawUploadPreset": "job_portal_cvs"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
