{
  "info": {
    "name": "Job Portal API",
    "description": "Import this collection in Postman. Set baseUrl to http://localhost:5046 and run requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5046" },
    { "key": "employerToken", "value": "" },
    { "key": "applicantToken", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "cvFileUrl", "value": "https://res.cloudinary.com/demo/image/upload/sample.pdf" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Employer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Employer\",\n  \"email\": \"employer@postman.com\",\n  \"password\": \"Test123!\",\n  \"role\": \"Employer\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register Applicant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Applicant\",\n  \"email\": \"applicant@postman.com\",\n  \"password\": \"Test123!\",\n  \"role\": \"Applicant\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login Employer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('employerToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employer@postman.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login Applicant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('applicantToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"applicant@postman.com\",\n  \"password\": \"Test123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Logout (any logged-in user)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. Jobs",
      "item": [
        {
          "name": "Get All Jobs (public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/jobs"
          }
        },
        {
          "name": "Create Job (Employer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.job && json.job.id) {",
                  "  pm.collectionVariables.set('jobId', json.job.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Software Developer\",\n  \"company\": \"Tech Co\",\n  \"description\": \"Build and maintain APIs\",\n  \"location\": \"Remote\",\n  \"experience\": \"2+ years\"\n}"
            },
            "url": "{{baseUrl}}/api/jobs"
          }
        },
        {
          "name": "Get Job By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Update Job (Employer)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Senior Software Developer\",\n  \"company\": \"Tech Co\",\n  \"description\": \"Lead API development\",\n  \"location\": \"Hybrid\",\n  \"experience\": \"5+ years\"\n}"
            },
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Delete Job (Employer)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          }
        }
      ]
    },
    {
      "name": "3. Applications",
      "item": [
        {
          "name": "Apply For Job (Applicant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.applicationId) {",
                  "  pm.collectionVariables.set('applicationId', json.applicationId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{applicantToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": \"{{jobId}}\",\n  \"yearsOfExperience\": 3,\n  \"skills\": \"C#, ASP.NET, MongoDB\",\n  \"educationLevel\": \"Bachelor\",\n  \"cvFileUrl\": \"{{cvFileUrl}}\",\n  \"message\": \"I am interested in this role.\"\n}"
            },
            "url": "{{baseUrl}}/api/applications/apply"
          }
        },
        {
          "name": "Get Applicants For Job (Employer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "url": "{{baseUrl}}/api/applications/job/{{jobId}}"
          }
        },
        {
          "name": "Update Application (Applicant)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{applicantToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"yearsOfExperience\": 4,\n  \"skills\": \"C#, ASP.NET, MongoDB, React\",\n  \"educationLevel\": \"Bachelor\",\n  \"cvFileUrl\": \"{{cvFileUrl}}\",\n  \"message\": \"Updated application message.\"\n}"
            },
            "url": "{{baseUrl}}/api/applications/update/{{applicationId}}"
          }
        },
        {
          "name": "Delete Application (Applicant)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{applicantToken}}" }
            ],
            "url": "{{baseUrl}}/api/applications/delete/{{applicationId}}"
          }
        }
      ]
    },
    {
      "name": "4. Upload",
      "item": [
        {
          "name": "Upload CV File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.url) {",
                  "  pm.collectionVariables.set('cvFileUrl', json.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{applicantToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/upload/cv"
          }
        },
        {
          "name": "Upload Job Image (Employer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/upload/job-image"
          }
        },
        {
          "name": "Upload Company Logo (Employer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": "{{baseUrl}}/api/upload/company-logo"
          }
        },
        {
          "name": "Storage Diagnostics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "url": "{{baseUrl}}/api/upload/diagnostics"
          }
        }
      ]
    },
    {
      "name": "5. Protected (test)",
      "item": [
        {
          "name": "Get Protected Data",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{employerToken}}" }
            ],
            "url": "{{baseUrl}}/api/Protected"
          }
        }
      ]
    }
  ]
}
